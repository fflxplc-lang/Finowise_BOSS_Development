# Copy to /home/finowise-test/app.env, fill in, then chmod 600.
# Use NEW secrets here (openssl rand -hex 32), never the production ones.
PORT=3001
HOST=127.0.0.1
CRM_DB_FILE=/home/finowise-test/data/data.json
CRM_USERS_DB=/home/finowise-test/data/users.db
CRM_API_KEY=
CRM_SESSION_SECRET=

# RIA research (all optional; the defaults read the public sources directly).
# CRM_WEBSITE_URL is only a fallback: the firm's website is normally set in
# Setup → RIA AI Assistant → The company website.
# CRM_WEBSITE_URL=https://www.yourfirm.in
# CRM_MFAPI_URL=https://api.mfapi.in
# CRM_MARKET_COOKIE_URL=https://fc.yahoo.com
